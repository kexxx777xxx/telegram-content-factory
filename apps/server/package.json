{
  "name": "@tcf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:migrate",
    "build:server": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --external:pg-native --external:argon2 --external:sharp --external:@resvg/resvg-js",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/migrate.cjs --external:pg-native --external:argon2",
    "start": "node dist/server.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.cjs",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tcf/shared": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
