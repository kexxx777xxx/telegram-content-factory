# Copy to `app.env` and fill in. Loaded by the server on boot and by
# docker-compose via `env_file`.
#
# Deliberately NOT named `.env`: docker compose auto-loads `.env` for its own
# variable interpolation and would mangle every value containing `$` — most
# painfully ADMIN_PASSWORD_HASH, whose argon2 form is `$argon2id$v=19$m=…`.
# The compose entry additionally sets `format: raw` for the same reason.

# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tcf:tcf@localhost:5432/tcf

# ─────────────────────────────────────────────────────────────
# HTTP server
# ─────────────────────────────────────────────────────────────
PORT=3000
# Bind to loopback by default. Changing this to 0.0.0.0 exposes the admin UI —
# do it only behind a reverse proxy / VPN, and never together with
# ADMIN_AUTH_ENABLED=false.
ADMIN_BIND_HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────
# Admin authentication
# ─────────────────────────────────────────────────────────────
# false disables the login wall entirely (local dev, or when the app already
# sits behind VPN / Cloudflare Access). The server logs a loud warning and the
# UI shows a permanent banner while this is off.
ADMIN_AUTH_ENABLED=true
# argon2id hash of the admin password. Generate with:
#   npm run -w @tcf/server hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
# 32-byte random secret for signing the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# Secret encryption (AES-256-GCM) for bot tokens and API keys at rest
# 64 hex chars = 32 bytes. Losing this makes stored secrets unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
APP_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Media staging (buffered posts only; emptied on publish)
# ─────────────────────────────────────────────────────────────
MEDIA_STAGING_DIR=./data/media

# Apply pending migrations on boot. Keep true for the single-instance setup so
# `docker compose up` works on a clean volume.
AUTO_MIGRATE=true

# ─────────────────────────────────────────────────────────────
# Workers and scheduler
# ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
PLANNER_TICK_SECONDS=60
PUBLISHER_TICK_SECONDS=30
PUBLISH_GRACE_MINUTES=30

# ─────────────────────────────────────────────────────────────
# Retention (prune job, daily)
# ─────────────────────────────────────────────────────────────
EVENT_RETENTION_DAYS=30
JOB_RETENTION_DAYS=7
# 0 = wipe post text immediately on publish (default; only the permalink remains)
POST_TEXT_RETENTION_DAYS=0
STAGING_ORPHAN_HOURS=2

# ─────────────────────────────────────────────────────────────
# Optional global admin bot (alerts, approval cards, backups).
# Leave empty to disable — publish_mode=auto works without it.
# ─────────────────────────────────────────────────────────────
ADMIN_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to press approval buttons.
ADMIN_USER_IDS=
